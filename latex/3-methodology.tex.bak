\end{figure}
\begin{figure}[H]
    \centering
    \IfFileExists{diagrams/05_feedback_loop_detail.png}{%
        \includegraphics[width=\linewidth, height=0.9\textheight, keepaspectratio]{diagrams/05_feedback_loop_detail.png}%
    }{%
